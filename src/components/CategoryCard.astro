---
// Tarjeta no clicable (UX-08): sin hover ni foco. pending => insignia "A confirmar" (A-04).
import { Image } from 'astro:assets';
import type { Category } from '../content/types';
import { CAT } from '../content/copy';
import IconTile from './IconTile.astro';
import StatusBadge from './StatusBadge.astro';

interface Props {
  category: Category;
  density: 'compact' | 'full';
  headingLevel?: 3;
}
const { category, density } = Astro.props;
const pending = category.status === 'pending';
---
{density === 'compact' ? (
  <li class="flex h-full items-start gap-4 rounded-card border border-borde bg-blanco p-4 md:p-5">
    <IconTile icon={category.icon} tone="crema" />
    <div class="min-w-0">
      <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
        <h3 class="text-h3">{category.title}</h3>
        {pending && <StatusBadge label={CAT.BADGE} srText={CAT.BADGE_SR} />}
      </div>
      <p class="mt-1 text-tinta">{category.descShort}</p>
    </div>
  </li>
) : (
  <li class="flex h-full flex-col overflow-hidden rounded-card border border-borde bg-blanco shadow-card">
    {category.image ? (
      <Image
        src={category.image.src}
        alt=""
        widths={[480, 720, 960]}
        sizes="(min-width: 1024px) 360px, (min-width: 768px) 50vw, 100vw"
        class="aspect-[16/10] w-full object-cover"
      />
    ) : (
      <div aria-hidden="true" class="relative flex aspect-[16/10] items-center justify-center overflow-hidden bg-crema">
        <span class="absolute -left-4 -top-4 h-16 w-16 rounded-full bg-amarillo"></span>
        <span class="absolute bottom-4 right-6 h-6 w-6 rounded-full bg-amarillo"></span>
        <svg class="absolute -bottom-2 left-6 text-verde" width="48" height="40" viewBox="0 0 48 40" aria-hidden="true" focusable="false">
          <path d="M2 38C2 18 16 4 46 2 42 26 26 38 2 38z" fill="currentColor" />
        </svg>
        <IconTile icon={category.icon} size="lg" tone="blanco" class="relative" />
      </div>
    )}
    <div class="flex flex-1 flex-col p-5">
      <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
        <h3 class="text-h3">{category.title}</h3>
        {pending && <StatusBadge label={CAT.BADGE} srText={CAT.BADGE_SR} />}
      </div>
      <p class="mt-2 text-tinta">{category.descLong}</p>
    </div>
  </li>
)}
