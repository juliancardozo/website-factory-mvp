---
import type { ImageAsset } from '../content/types';
import { Image } from 'astro:assets';
import Container from './Container.astro';
import Illustration from './Illustration.astro';

interface Props {
  title: string;
  subtitle?: string;
  paragraphs?: string[];
  visual?: 'none' | 'illustration';
  illustration?: 'canasta' | 'pin' | 'gondola';
  image?: ImageAsset | null;
}
const { title, subtitle, paragraphs = [], visual = 'illustration', illustration = 'canasta', image = null } = Astro.props;
const showVisual = visual !== 'none';
---
<div class="bg-crema">
  <Container class="grid gap-8 py-10 md:py-14 lg:grid-cols-12 lg:items-center lg:gap-10 lg:py-18">
    <div class:list={[showVisual ? 'lg:col-span-7' : 'lg:col-span-12']}>
      <h1 class="text-h1">{title}</h1>
      {subtitle && <p class="mt-4 max-w-texto text-lead text-tinta">{subtitle}</p>}
      {paragraphs.map((p, i) => (
        <p class:list={['max-w-texto text-tinta', i === 0 ? 'mt-4 text-lead' : 'mt-3 lg:text-body-lg']}>{p}</p>
      ))}
      <slot />
    </div>
    {showVisual && (
      <div class="hidden lg:col-span-5 lg:block">
        {image ? (
          <Image src={image.src} alt={image.alt} widths={[480, 720]} sizes="(min-width: 1024px) 420px, 100vw" class="w-full rounded-media object-cover" />
        ) : (
          <Illustration name={illustration} class="h-auto w-full rounded-media" />
        )}
      </div>
    )}
  </Container>
</div>
