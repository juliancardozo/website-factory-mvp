---
interface Props {
  as?: 'div' | 'section';
  width?: 'site' | 'texto';
  class?: string;
}
const { as: Tag = 'div', width = 'site', class: className } = Astro.props;
---
<Tag class:list={['mx-auto w-full px-4 md:px-8 lg:px-10', width === 'site' ? 'max-w-site' : 'max-w-[calc(var(--container-texto)+5rem)]', className]}>
  <slot />
</Tag>
