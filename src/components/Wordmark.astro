---
// Logotipo textual provisional (PLACEHOLDER, A-03): no es el logo oficial del comercio.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { Surface } from '../content/types';
import { GLB } from '../content/copy';

interface Props {
  surface: Surface;
  size?: 'sm' | 'md';
  logoSrc?: ImageMetadata;
}
const { surface, size = 'md', logoSrc } = Astro.props;
const dark = surface === 'dark';
const [first, ...rest] = GLB.HDR_LOGO.split(' ');
const second = rest.join(' ');
---
<a href="/" aria-label={GLB.HDR_LOGO_ARIA} class="inline-flex min-h-11 shrink-0 flex-col justify-center leading-none">
  {logoSrc ? (
    <Image src={logoSrc} alt="" class="h-10 w-auto md:h-12" />
  ) : (
    <>
      <span class:list={['font-display font-semibold uppercase tracking-[0.12em]', size === 'md' ? 'text-[0.75rem] md:text-[0.8125rem]' : 'text-[0.75rem]', dark ? 'text-crema' : 'text-tinta']}>{first}</span>
      <span class="mt-0.5 inline-flex items-center gap-1">
        <span class:list={['font-display font-bold', size === 'md' ? 'text-[1.375rem] md:text-[1.625rem]' : 'text-[1.375rem]', dark ? 'text-blanco' : 'text-verde-oscuro']}>{second}</span>
        <svg aria-hidden="true" focusable="false" width="10" height="14" viewBox="0 0 10 14" class="text-verde">
          <path d="M1 13C1 6 4 2 9 1c0 6-3 11-8 12z" fill="currentColor" />
        </svg>
        <span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-amarillo"></span>
      </span>
    </>
  )}
</a>
