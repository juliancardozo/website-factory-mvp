---
// Ilustraciones SVG propias y decorativas (design-system §10.3). Sin texto, paleta exclusiva.
// No representan el local real ni su ubicación geográfica.
interface Props {
  name: 'mercado' | 'canasta' | 'gondola' | 'pin' | 'hojas';
  class?: string;
}
const { name, class: className } = Astro.props;

const V = '#27834B';
const VO = '#185C38';
const C = '#FFF9ED';
const B = '#FFFFFF';
const A = '#F5C84C';
const BO = '#E8DFCB';

const leaf = (x: number, y: number, r: number, s: number, fill: string, vein: string) =>
  `<g transform="translate(${x} ${y}) rotate(${r}) scale(${s})"><path d="M0 0C10-30 40-46 70-40C64-12 36 8 0 0Z" fill="${fill}"/><path d="M6-3C24-14 42-24 62-36" stroke="${vein}" stroke-width="3" stroke-linecap="round" fill="none"/></g>`;

const svgs = {
  mercado: {
    viewBox: '0 0 640 520',
    par: 'xMidYMid slice',
    body: `
<rect width="640" height="520" fill="${VO}"/>
<circle cx="470" cy="150" r="230" fill="${V}"/>
<rect x="420" y="56" width="168" height="96" rx="14" fill="${C}"/>
<rect x="436" y="74" width="136" height="16" rx="8" fill="${V}"/>
<rect x="436" y="104" width="96" height="10" rx="5" fill="${BO}"/>
<rect x="436" y="124" width="72" height="10" rx="5" fill="${BO}"/>
<circle cx="120" cy="120" r="8" fill="${A}"/>
<circle cx="330" cy="104" r="7" fill="${A}"/>
<circle cx="86" cy="250" r="5" fill="${A}"/>
<circle cx="580" cy="262" r="6" fill="${A}"/>
${leaf(232, 214, -20, 1.1, V, C)}
${leaf(400, 222, -150, 1, V, C)}
<ellipse cx="215" cy="252" rx="36" ry="25" fill="${A}"/>
<ellipse cx="318" cy="238" rx="38" ry="26" fill="${A}"/>
<ellipse cx="420" cy="252" rx="34" ry="24" fill="${A}"/>
<circle cx="168" cy="304" r="46" fill="${V}"/>
<circle cx="262" cy="292" r="52" fill="${C}"/>
<circle cx="364" cy="300" r="48" fill="${V}"/>
<circle cx="458" cy="306" r="44" fill="${C}"/>
<path d="M262 240c0-12 6-20 14-24M364 252c0-10 5-17 12-21" stroke="${VO}" stroke-width="5" stroke-linecap="round" fill="none"/>
<rect x="90" y="330" width="460" height="150" rx="20" fill="${A}"/>
<rect x="112" y="366" width="416" height="12" rx="6" fill="${B}" fill-opacity="0.45"/>
<rect x="112" y="404" width="416" height="12" rx="6" fill="${B}" fill-opacity="0.45"/>
<rect x="112" y="442" width="416" height="12" rx="6" fill="${B}" fill-opacity="0.45"/>`,
  },
  canasta: {
    viewBox: '0 0 320 240',
    par: 'xMidYMid meet',
    body: `
<path d="M92 118C92 40 228 40 228 118" stroke="${VO}" stroke-width="14" stroke-linecap="round" fill="none"/>
<ellipse cx="200" cy="96" rx="58" ry="16" transform="rotate(-28 200 96)" fill="${C}" stroke="${BO}" stroke-width="4"/>
<circle cx="132" cy="102" r="24" fill="${A}"/>
${leaf(150, 112, -60, 0.9, V, C)}
<path d="M48 114H272L247 210Q245 222 232 222H88Q75 222 73 210Z" fill="${VO}"/>
<path d="M66 146H254M72 178H248" stroke="${C}" stroke-opacity="0.35" stroke-width="6" stroke-linecap="round"/>`,
  },
  gondola: {
    viewBox: '0 0 400 320',
    par: 'xMidYMid meet',
    body: `
<rect width="400" height="320" rx="24" fill="${V}"/>
<rect x="44" y="34" width="44" height="66" rx="8" fill="${B}"/>
<rect x="98" y="54" width="36" height="46" rx="18" fill="${A}"/>
<rect x="144" y="24" width="40" height="76" rx="8" fill="${VO}"/>
<rect x="194" y="48" width="56" height="52" rx="8" fill="${B}"/>
<rect x="260" y="40" width="34" height="60" rx="17" fill="${A}"/>
<rect x="304" y="58" width="52" height="42" rx="8" fill="${VO}"/>
<rect x="30" y="100" width="340" height="12" rx="6" fill="${C}"/>
<rect x="48" y="138" width="38" height="52" rx="19" fill="${VO}"/>
<rect x="96" y="128" width="54" height="62" rx="8" fill="${A}"/>
<rect x="160" y="146" width="44" height="44" rx="8" fill="${B}"/>
<rect x="214" y="120" width="40" height="70" rx="8" fill="${VO}"/>
<rect x="264" y="140" width="36" height="50" rx="18" fill="${B}"/>
<rect x="310" y="132" width="46" height="58" rx="8" fill="${A}"/>
<rect x="30" y="190" width="340" height="12" rx="6" fill="${C}"/>
<rect x="44" y="222" width="60" height="58" rx="8" fill="${B}"/>
<rect x="114" y="232" width="36" height="48" rx="18" fill="${A}"/>
<rect x="160" y="214" width="46" height="66" rx="8" fill="${VO}"/>
<rect x="216" y="236" width="50" height="44" rx="8" fill="${A}"/>
<rect x="276" y="222" width="36" height="58" rx="18" fill="${B}"/>
<rect x="322" y="230" width="36" height="50" rx="8" fill="${VO}"/>
<rect x="30" y="280" width="340" height="12" rx="6" fill="${C}"/>`,
  },
  pin: {
    viewBox: '0 0 400 300',
    par: 'xMidYMid slice',
    body: `
<rect width="400" height="300" fill="${C}"/>
<path d="M-20 90L420 60M-20 220L420 250M110-20L150 320M290-20L260 320M150 150L420 140" stroke="${BO}" stroke-width="18" stroke-linecap="round" fill="none"/>
<path d="M200 230s-52-46-52-86a52 52 0 0 1 104 0c0 40-52 86-52 86z" fill="${VO}"/>
<circle cx="200" cy="142" r="20" fill="${A}"/>`,
  },
  hojas: {
    viewBox: '0 0 1200 400',
    par: 'xMidYMid slice',
    body: `
${leaf(-10, 90, 20, 2.2, V, V)}
${leaf(30, 420, -40, 2.6, V, V)}
${leaf(1210, 40, 160, 2.4, V, V)}
${leaf(1160, 430, -120, 2.2, V, V)}`,
  },
} as const;

const svg = svgs[name];
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={svg.viewBox}
  preserveAspectRatio={svg.par}
  aria-hidden="true"
  focusable="false"
  class={className}
  set:html={svg.body}
/>
