---
// Footer (design-system #6). Sin redes, email ni WhatsApp (A-11): los canales pendientes no se consumen.
import { categories, heroImage, navItems } from '../content/site';
import { GLB } from '../content/copy';
import Container from './Container.astro';
import Wordmark from './Wordmark.astro';
import AddressBlock from './AddressBlock.astro';
import PhoneBlock from './PhoneBlock.astro';
import HoursList from './HoursList.astro';
import NavLinks from './NavLinks.astro';

const year = new Date().getFullYear();
const footerItems = navItems.map((i) => ({ href: i.href, label: i.footerLabel ?? i.label }));
// UX-10: la nota de imágenes solo se muestra si algún slot usa foto.
const hasPhotos = [heroImage, ...categories.map((c) => c.image)].some((img) => img !== null);
const h = 'text-small font-semibold uppercase tracking-[0.08em] font-sans text-blanco';
---
<footer data-surface="dark" class="bg-tinta text-crema">
  <Container class="py-12 md:py-14">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      <div>
        <Wordmark surface="dark" size="md" />
        <p class="mt-3 max-w-texto">{GLB.FTR_TAGLINE}</p>
      </div>
      <div class="flex flex-col gap-6">
        <AddressBlock title={GLB.FTR_H_ADDR} headingLevel={2} format="full" surface="dark" headingClass={h} />
        <PhoneBlock title={GLB.FTR_H_PHONE} headingLevel={2} surface="dark" headingClass={h} />
      </div>
      <div>
        <HoursList title={GLB.FTR_H_HOURS} headingLevel={2} surface="dark" compact headingClass={h} />
      </div>
      <div>
        <h2 id="pie-secciones" class={h}>{GLB.FTR_H_NAV}</h2>
        <nav aria-label={GLB.FTR_NAV_ARIA} class="mt-2">
          <NavLinks items={footerItems} currentPath="" layout="stacked" surface="dark" />
        </nav>
      </div>
    </div>
    <div class="mt-10 flex flex-col gap-2 border-t border-crema/20 pt-6 text-small md:flex-row md:justify-between">
      <p>{GLB.FTR_COPY(year)}</p>
      {hasPhotos && <p>{GLB.FTR_IMG_NOTE}</p>}
    </div>
  </Container>
</footer>
